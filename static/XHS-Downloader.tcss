Button {
    width: 1fr;
    margin: 1 1;
}
.vertical-layout {
    layout: vertical;
    height: auto;
}
.horizontal-layout, .settings_button {
    layout: horizontal;
    height: auto;
}
.horizontal-layout > * {
    width: 1fr;
}
#album_download_mode {
    layout: horizontal;
    height: 3;
    border: round $border-blurred;
    border-title-align: center;
    border-title-color: $primary;
    background: $surface;
    padding: 0;
}
#album_download_mode:focus {
    border: round $primary;
}
#album_download_mode > RadioButton {
    width: 1fr;
    height: 1;
    margin: 0 1;
    border: none;
    padding: 0;
    background: transparent;
    content-align: center middle;
}
#album_download_mode > RadioButton > .toggle--label {
    background: transparent;
    color: $text-muted;
    text-style: none;
}
#album_download_mode > RadioButton.-on {
    background: $primary 25%;
}
#album_download_mode > RadioButton.-on > .toggle--label {
    color: $text;
    text-style: bold;
}
#album_download_mode:focus > RadioButton.-selected > .toggle--label {
    text-style: underline;
}
Button#deal, Button#paste, Button#save, Button#enter {
    color: $success;
}
Button#reset, Button#abandon, Button#close {
    color: $error;
}
Label, Link {
    width: 100%;
    content-align-horizontal: center;
    content-align-vertical: middle;
}
Link {
    color: $accent;
}
Label.params {
    margin: 1 0 0 0;
    color: $primary;
}
Label.prompt {
    padding: 1;
}
.loading {
    grid-size: 1 2;
    grid-gutter: 1;
    width: 40vw;
    height: 5;
    border: double $primary;
}
#record {
    grid-size: 1 3;
    width: 80vw;
    height: 12;
    border: double $primary;
}
ModalScreen {
    align: center middle;
}
